<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed CyberSync notification: fits Android 12+'s 48dp custom-content limit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_cyber_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="10dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/cyber_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="#FF00F0FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cyber_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFCFE8FF"
        android:textSize="12sp" />
</LinearLayout>
