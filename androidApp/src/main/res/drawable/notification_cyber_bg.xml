<?xml version="1.0" encoding="utf-8"?>
<!-- CyberSync notification card: near-black panel, thin neon-cyan frame, magenta strip on the left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F20A0A14" />
            <stroke android:width="1dp" android:color="#8000F0FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical" android:top="1dp" android:bottom="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF2A6D" />
        </shape>
    </item>
</layer-list>
